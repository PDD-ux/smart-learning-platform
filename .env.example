# ============================================================
# 智能学习平台 · 环境变量示例
# ============================================================
# 用法：
#   1. cp .env.example .env.local      # 本地开发
#   2. 按需填入真实密钥
#   3. 部署环境（CI / 生产）由部署平台注入
#
# 安全约束（强制）：
#   - 所有 API Key / Secret 仅从环境变量读取
#   - 绝不写入日志、绝不写入响应（参考 src/lib/ai/deepseek.ts 的错误码脱敏）
#   - 生产环境 NODE_ENV=production 时 devCode / dev-* 字段一律不回传
#
# 字段说明：
#   ✅ 必填  = 不填则启动失败或核心功能不可用
#   ⭕ 推荐  = 强烈建议填，影响生产体验
#   ⚪ 可选  = 留空则走降级方案（mock / 本地默认值）
# ============================================================


# =============================================================
# 1. 基础配置
# =============================================================
NODE_ENV="development"                  # development | test | production
APP_NAME="文豪智能学习平台"
APP_URL="http://localhost:3000"          # ✅ 必填，邮件链接/CORS/回调需要
API_PREFIX="/api"                       # 默认 /api，可不填
PORT="3000"                             # 默认 3000


# =============================================================
# 2. 数据库（PostgreSQL 15+）
# =============================================================
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/smart_learning?schema=public"   # ✅ 必填；生产使用独立强密码账号
DATABASE_LOG_QUERIES="false"            # ⚪ 可选：开发时调试 SQL


# =============================================================
# 3. 缓存 / 队列（Redis 7+）
# =============================================================
REDIS_URL="redis://:<password>@localhost:6379"   # ✅ 必填（BullMQ + 限流 + 进度缓存共用）
REDIS_DB="0"                            # ⚪ 可选，默认 0
REDIS_PASSWORD=""                       # ⚪ 可选（生产建议填）


# =============================================================
# 4. AI 大模型（仅讯飞星火）
# =============================================================
LLM_PROVIDER="spark"                     # 仅支持spark，统一控制所有文本大模型任务
SPARK_API_PASSWORD=""                    # 仅服务端读取；使用讯飞HTTP接口APIPassword
SPARK_BASE_URL="https://spark-api-open.xf-yun.com/v1"
SPARK_MODEL="lite"
SPARK_TIMEOUT_MS="60000"
AGENT_REVIEW_READY="false"               # 通过新模型真实忠实性回放后才能开启原文解释
AGENT_REVIEW_THINKING="false"            # 显式开启逐句覆盖与术语复核；未通过实测不要开启

# ---- OCR 云端兜底（可选，不配置则只用本地引擎） --------------------
# 仅当本地 OCR 结果为空或置信度不足时才调用，用于手写体/复杂公式/模糊拍照。
# 需为支持图片输入的 OpenAI 兼容视觉服务；三项任一留空即视为关闭。
VISION_OCR_BASE_URL=""                   # 例如 https://spark-api-open.xf-yun.com/v1
VISION_OCR_API_KEY=""                    # 服务端专用，禁止写入前端
VISION_OCR_MODEL=""                      # 例如 4.0Ultra（须确认该型号开通图片理解）
VISION_OCR_TIMEOUT_MS="30000"


# =============================================================
# 5. 语音转写（ASR · 可替换）
# =============================================================
# 真实课堂转写可选讯飞或已准备的本地FunASR；缺少所选服务配置时显式不可用，不会生成假转写。
# 仅测试/本地演示可显式设 ASR_PROVIDER=mock（生成内容会标注为 mock）。
ASR_PROVIDER="xunfei"                  # xunfei | funasr-local | mock（生产禁止mock）
ASR_LOCAL_PYTHON=""                    # funasr-local: 隔离Python绝对路径，使用正斜杠
ASR_LOCAL_MODEL_DIR=""                 # funasr-local: 已校验Paraformer/FSMN-VAD模型目录
ASR_API_KEY=""                          # 讯飞 ASR 服务 SecretKey（不是星火 SPARK_API_PASSWORD）
ASR_BASE_URL="https://raasr.xfyun.cn/v2/api" # 可选：讯飞录音文件转写 API 根路径
ASR_APP_ID=""                           # 讯飞开放平台 AppID
ASR_LANGUAGE="cn"                       # 讯飞语种代码，默认中文
ASR_POLL_INTERVAL_MS="10000"            # 订单结果轮询间隔
ASR_POLL_MAX_ATTEMPTS="90"              # 单笔订单轮询上限，低于讯飞 100 次限制
ASR_REQUEST_TIMEOUT_MS="60000"          # 单次讯飞 HTTP 请求超时


# =============================================================
# 6. 对象存储（S3 兼容 · MinIO / 阿里 OSS / 腾讯 COS）
# =============================================================
# 驱动：local = MVP 本地 uploads/ 目录 + 预签名模拟（默认，无需外部依赖）
#       s3    = S3 兼容对象存储，走 AWS SDK 预签名（生产）
STORAGE_DRIVER="local"                  # ⚪ 可选：local | s3，默认 local
UPLOAD_DIR="uploads"                    # ⚪ 可选：仅 local 驱动，本地存储根目录（默认 <项目根>/uploads）
STORAGE_SIGN_SECRET=""                  # ⚪ 可选：仅 local 驱动，预签名模拟签名密钥（留空回退 JWT_SECRET）
S3_ENDPOINT="http://localhost:9000"     # ⚪ 可选：MinIO 用 9000；生产用阿里/腾讯 OSS 公网 endpoint
S3_PUBLIC_ENDPOINT=""                   # ⚪ 可选：预签名 URL 给浏览器使用的公网地址；Compose 留空会按 MINIO_PORT 生成 localhost 地址
S3_REGION="us-east-1"                   # ⚪ 可选
S3_ACCESS_KEY_ID=""                      # ⚪ 可选：请填专用访问密钥，勿使用公开示例凭据
S3_SECRET_ACCESS_KEY=""                  # ⚪ 可选：请填专用访问密钥，勿提交到仓库
S3_BUCKET="slp-learning"                # ⚪ 可选：Compose 初始化的私有 bucket
S3_FORCE_PATH_STYLE="true"              # ⚪ 可选：MinIO 必须 true；AWS/阿里 OSS 建议 false
S3_PRESIGNED_EXPIRES="3600"             # ⚪ 可选：预签名 URL 有效期（秒），默认 3600


# =============================================================
# 6.1 人脸签到敏感数据加密（P1，服务端专用）
# =============================================================
# 使用两个彼此不同的 32 字节密钥：`openssl rand -base64 32`。
# 仅服务端读取，禁止 NEXT_PUBLIC_ 前缀；照片密文固定写入私有 face-enrollment/ 前缀，
# 不生成公开或预签名读取地址。生产环境缺失、格式错误、全重复字节的弱密钥会被拒绝。
FACE_TEMPLATE_ENCRYPTION_KEY=""          # ⭕ Base64 32 字节随机密钥，用于特征向量
FACE_TEMPLATE_ENCRYPTION_KEY_ID=""       # ⭕ 轮换标识，例如 face-template-2026-09
FACE_ENROLLMENT_PHOTO_ENCRYPTION_KEY=""  # ⭕ 与向量密钥不同，用于一次录入照片
FACE_ENROLLMENT_PHOTO_ENCRYPTION_KEY_ID="" # ⭕ 轮换标识，例如 face-photo-2026-09
FACE_CHALLENGE_SECRET=""                 # ⭕ 至少 32 字符随机串，用于签发 2 分钟有效的活体挑战令牌

# 已获授权的人脸模型服务。默认不配置；人脸登录返回503，使用密码登录和普通每日打卡。
# 服务仅可部署在私网或 HTTPS；它需要实现 POST /v1/face/enroll 与 /v1/face/verify 两个契约。
FACE_VERIFICATION_PROVIDER=""            # licensed-http | 留空（停用人脸登录，不影响密码登录）
FACE_LOGIN_MODE="action"                # action动作核验 | scan一次扫描（无活体，仅便捷演示，有照片冒用风险）
FACE_INFER_URL=""                        # ⭕ 生产必须为 https:// 的受控服务地址
FACE_INFER_TOKEN=""                      # ⭕ 服务端专用 Bearer Token，禁止写入前端
FACE_INFER_MODEL_VERSION=""              # ⭕ 已获授权、完成阈值验证的固定模型版本


# =============================================================
# 6.1 媒体工具（ffprobe / ffmpeg，视频解析 tasks.md §3.2）
# =============================================================
# 留空 → 从 PATH 查找；无 ffmpeg 环境时解析降级（跳过元数据/封面，仍置已就绪）
FFPROBE_PATH=""                         # ⚪ 可选：ffprobe 可执行文件绝对路径
FFMPEG_PATH=""                          # ⚪ 可选：ffmpeg 可执行文件绝对路径

# =============================================================
# 6.2 扫描 PDF 页渲染（Poppler，扫描页视觉 OCR）
# =============================================================
# 留空 → 从 PATH 查找 pdftoppm；不可用时保留 PDF 文本层、跳过扫描页 OCR，不阻塞学习链路。
PDFTOPPM_PATH=""                        # ⚪ 可选：Poppler pdftoppm 可执行文件绝对路径


# =============================================================
# 7. MindSpore 端侧推理服务（services/mindspore-infer）
# =============================================================
# 留空 / 服务不可达 → InferenceGateway 自动切本地 mock（均匀抽帧 + unknown 分类 + 空文本）
ASCEND_INFER_URL="http://localhost:8000"           # ⚪ 可选：默认 mock 模式
ASCEND_INFER_TIMEOUT_MS="8000"                     # ⚪ 可选：默认 8 秒
ASCEND_INFER_TOKEN=""                              # ⚪ 可选：与推理服务 X-Infer-Token 对齐（生产必须设置为随机值）
INFER_MAX_FRAMES="120"                             # ⚪ 可选：单次推理允许的最大帧数
INFER_MAX_IMAGE_BYTES="5242880"                    # ⚪ 可选：单张图片最大字节数（默认 5 MiB）
INFER_MAX_REQUEST_BYTES="20971520"                 # ⚪ 可选：单次推理图片总字节数（默认 20 MiB）


# =============================================================
# 8. JWT 鉴权
# =============================================================
JWT_SECRET=""                                      # ✅ 生产必填：至少 32 字符随机串；开发未配置时仅使用进程内开发密钥
JWT_ACCESS_TTL="15m"                              # ⚪ 可选：access token 有效期
JWT_REFRESH_TTL="30d"                             # ⚪ 可选：refresh token 有效期
JWT_ISSUER="smart-learning-platform"               # ⚪ 可选：签发者标识


# =============================================================
# 9. 公网视频抓取（伴生学习 · tasks §3 import-from-url）
# =============================================================
# 留空 → 仅支持本地上传
PUBLIC_VIDEO_ALLOWED_DOMAINS="bilibili.com,bilibili.cn,youtube.com,youtu.be"   # ⚪ 可选：白名单
PUBLIC_VIDEO_ROBOTS_CACHE_TTL="86400"             # ⚪ 可选：robots.txt 缓存秒数
PUBLIC_VIDEO_FETCH_TIMEOUT_MS="30000"             # ⚪ 可选：抓取超时
PUBLIC_VIDEO_MAX_SIZE_MB="2048"                   # ⚪ 可选：单视频上限（MB），默认 2GB


# =============================================================
# 10. 限流（按接口分级）
# =============================================================
RATE_LIMIT_AUTH_PER_MIN="5"            # 登录/注册等鉴权接口（每 IP 每分钟），默认 5
RATE_LIMIT_AI_PER_MIN="10"             # AI/推理类接口（每用户每分钟），默认 10
RATE_LIMIT_FACE_PER_MIN="5"             # 人脸录入/活体验证（每用户每分钟），默认 5
RATE_LIMIT_DEFAULT_PER_MIN="60"        # 通用接口（每用户每分钟），默认 60
TRUST_PROXY="false"                    # 仅当反向代理会剥离外部转发头时设为 true


# =============================================================
# 11. 异步队列（BullMQ worker）
# =============================================================
QUEUE_DRIVER="memory"                  # ⚪ 可选：memory（进程内，MVP 默认，无需 Redis）| bullmq（生产）
QUEUE_CONCURRENCY="4"                  # ⚪ 可选：worker 并发数，默认 4
QUEUE_RETRY_MAX="3"                    # ⚪ 可选：任务最大重试次数，默认 3
QUEUE_RETRY_BACKOFF_MS="5000"          # ⚪ 可选：重试退避基础时长，默认 5 秒（指数退避）
QUEUE_REMOVE_ON_COMPLETE="100"         # ⚪ 可选：完成后保留 N 条记录用于排错
QUEUE_REMOVE_ON_FAIL="500"             # ⚪ 可选：失败后保留 N 条记录


# =============================================================
# 11.1 Docker Compose 基础设施凭据（仅 docker compose 使用）
# =============================================================
# Compose 启动时以下变量必须设置；建议用密码管理器或 `openssl rand -base64 32` 生成。
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB="slp"
REDIS_PASSWORD=""
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
INFER_TOKEN=""                         # 与 ASCEND_INFER_TOKEN 使用同一随机值

# 可选端口覆盖。S3_PUBLIC_ENDPOINT 留空时会自动使用 MINIO_PORT；远程访问时改为浏览器可达的 URL。
POSTGRES_PORT="5432"
REDIS_PORT="6379"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
INFER_PORT="8001"
NEXT_PORT="3000"

# 可选种子账号：未完整配置时 prisma:seed 会安全跳过，不再创建固定账号。
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""                  # 至少 12 字符
SEED_ADMIN_NICKNAME="管理员"
SEED_DEMO_EMAIL=""
SEED_DEMO_PASSWORD=""                   # 至少 12 字符
SEED_DEMO_NICKNAME="演示学员"


# =============================================================
# 12. 日志 / 监控（可选）
# =============================================================
LOG_LEVEL="info"                       # debug | info | warn | error
SENTRY_DSN=""                          # ⚪ 可选：Sentry 错误监控
ANALYTICS_ENABLED="false"              # ⚪ 可选：启用使用统计
METRICS_TOKEN=""                       # ⭕ 生产推荐：Prometheus 抓取 /api/metrics 的独立 Bearer Token；留空则端点返回 503


# =============================================================
# 13. 功能开关（Feature Flags）
# =============================================================
FEATURE_MINDSPORE_INFER="true"         # 启用端侧推理（关闭则直接走 mock）
FEATURE_ASR="true"                     # 启用语音转写（关闭则跳过转写阶段）
FEATURE_PUBLIC_VIDEO="true"            # 启用公网视频 URL 导入
FEATURE_GAMIFICATION="true"            # 启用轻游戏化（XP / streak / 成就）
FEATURE_GRAPH_RENDER="false"           # 启用 react-flow 图谱渲染（P1，默认关闭）
FEATURE_PRACTICE="false"               # 启用 AI 出题练习（P1，默认关闭）


# =============================================================
# 14. Next.js 配置（可选覆盖）
# =============================================================
NEXT_TELEMETRY_DISABLED="1"            # ⚪ 可选：关闭 Next.js 遥测
